{
  "openapi": "3.1.1",
  "info": {
    "title": "PushNotificationsService | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/subscriptions": {
      "post": {
        "tags": [
          "PushNotificationsEndpoints"
        ],
        "summary": "Register a device or web app for push notifications",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSubscriptionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Subscription created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PushSubscription"
                }
              }
            }
          },
          "400": {
            "description": "Invalid subscription request"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "get": {
        "tags": [
          "PushNotificationsEndpoints"
        ],
        "summary": "Get all active subscriptions for the current user",
        "responses": {
          "200": {
            "description": "List of subscriptions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PushSubscription"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/subscriptions/{id}": {
      "delete": {
        "tags": [
          "PushNotificationsEndpoints"
        ],
        "summary": "Remove a device from receiving push notifications",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Subscription deleted successfully"
          },
          "404": {
            "description": "Subscription not found"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/notifications": {
      "post": {
        "tags": [
          "PushNotificationsEndpoints"
        ],
        "summary": "Send a push notification to a user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendNotificationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Notification accepted for delivery",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PushNotification"
                }
              }
            }
          },
          "400": {
            "description": "Invalid notification request"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/notifications/{id}/status": {
      "get": {
        "tags": [
          "PushNotificationsEndpoints"
        ],
        "summary": "Get notification delivery status",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Notification status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PushNotification"
                }
              }
            }
          },
          "404": {
            "description": "Notification not found"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateSubscriptionRequest": {
        "required": [
          "deviceToken",
          "platform",
          "endpoint",
          "auth",
          "p256dh"
        ],
        "type": "object",
        "properties": {
          "deviceToken": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "endpoint": {
            "type": [
              "null",
              "string"
            ]
          },
          "auth": {
            "type": [
              "null",
              "string"
            ]
          },
          "p256dh": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PushNotification": {
        "required": [
          "id",
          "userId",
          "title",
          "body",
          "data",
          "createdAt",
          "sent"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "userId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "data": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "sent": {
            "type": "boolean"
          }
        }
      },
      "PushSubscription": {
        "required": [
          "id",
          "userId",
          "deviceToken",
          "platform",
          "endpoint",
          "auth",
          "p256dh",
          "createdAt",
          "updatedAt",
          "isActive"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "userId": {
            "type": "string"
          },
          "deviceToken": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "endpoint": {
            "type": [
              "null",
              "string"
            ]
          },
          "auth": {
            "type": [
              "null",
              "string"
            ]
          },
          "p256dh": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "SendNotificationRequest": {
        "required": [
          "userId",
          "title",
          "body",
          "data"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "data": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Bearer JWT authentication.",
        "scheme": "bearer",
        "bearerFormat": "Json Web Token"
      }
    }
  },
  "tags": [
    {
      "name": "PushNotificationsEndpoints"
    }
  ]
}