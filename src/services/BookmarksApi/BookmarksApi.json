            }
          }
        ],
        "responses": {
          "204": {
            "description": "Bookmark permanently deleted"
          },
          "404": {
            "description": "Bookmark not found or not archived"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/bookmarks/archive": {
      "post": {
        "tags": [
          "BookmarksEndpoints"
        ],
        "summary": "Archive multiple bookmarks by IDs",
        "requestBody": {
          "description": "Array of bookmark IDs to archive",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "pattern": "^-?(?:0|[1-9]\\d*)$",
