    },
    "/api/bookmarks/tags/move": {
      "put": {
        "tags": [
          "BookmarksEndpoints"
        ],
        "summary": "Move a tag to the front or end of the tag list for all bookmarks",
        "parameters": [
          {
            "name": "tagName",
            "in": "query",
            "description": "The tag to move",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "position",
            "in": "query",
            "description": "The target position: \"front\" or \"end\"",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tag move result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveTagResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid position parameter"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/tags": {
      "get": {
        "tags": [
          "TagsEndpoints"
        ],
        "summary": "Get user's tags with optional search query, sorting, and pagination",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Optional search query string.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Optional sort field. Values: id, name, usageCount, createdAt. Default: id",
            "schema": {
              "enum": [
                "Id",
                "Name",
                "UsageCount",
                "CreatedAt"
              ],
              "type": "string"
            }
          },
          {
            "name": "sortDirection",
            "in": "query",
            "description": "Optional sort direction. Values: asc, desc. Default: desc",
            "schema": {
              "enum": [
                "Asc",
                "Desc"
              ],
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of tags to return per page. Default: 20",
