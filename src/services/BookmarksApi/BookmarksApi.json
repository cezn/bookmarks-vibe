              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Optional cursor for pagination. Use the NextCursor from a previous response to get the next page of results. Encoded as a base64 string.",
            "schema": {
              "type": "string"
            }
