          }
        ],
        "responses": {
          "200": {
            "description": "The archived bookmark",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bookmark"
                }
              }
            }
          },
          "404": {
            "description": "Bookmark not found or already archived"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/bookmarks/{id}/restore": {
      "post": {
        "tags": [
          "BookmarksEndpoints"
