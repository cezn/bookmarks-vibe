    },
    "/api/bookmarks/{id}/permanent": {
      "delete": {
        "tags": [
          "BookmarksEndpoints"
        ],
        "summary": "Permanently delete an archived bookmark by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The bookmark ID to permanently delete",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
