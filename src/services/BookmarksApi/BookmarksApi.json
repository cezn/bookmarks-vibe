        "tags": [
          "BookmarksEndpoints"
        ],
        "summary": "Rename a tag on all bookmarks",
        "parameters": [
          {
            "name": "oldName",
            "in": "query",
            "description": "The old tag name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "newName",
            "in": "query",
            "description": "The new tag name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tag rename result",
            "content": {
              "application/json": {
