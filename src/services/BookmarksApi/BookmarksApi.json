{
  "openapi": "3.1.1",
  "info": {
    "title": "BookmarksApi | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/bookmarks": {
      "get": {
        "tags": [
          "BookmarksEndpoints"
        ],
        "summary": "Get user's bookmarks with optional search query, sorting, and pagination",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Optional search query string. Supports full-text search with phrases, boolean operators (AND, OR, NOT), and word variations.\nE.g. postgres &amp; (linux | windows)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tags",
            "in": "query",
            "description": "Optional array of tag names to filter bookmarks. Bookmarks containing any of these tags will be returned.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Optional sort field. Values: id, title, createdAt, updatedAt. Default: id",
            "schema": {
              "enum": [
                "Id",
                "Title",
                "CreatedAt",
                "UpdatedAt"
              ],
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of bookmarks to return per page. Default: 20",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 20
            }
          },
          {
            "name": "sortDirection",
            "in": "query",
            "description": "Optional sort direction. Values: asc, desc. Default: desc",
            "schema": {
              "enum": [
                "Asc",
                "Desc"
              ],
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Optional cursor for pagination. Use the NextCursor from a previous response to get the next page of results. Encoded as a base64 string.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of bookmarks",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetBookmarksResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "post": {
        "tags": [
          "BookmarksEndpoints"
        ],
        "summary": "Create a new bookmark",
        "requestBody": {
          "description": "The bookmark to create",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Bookmark"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The created bookmark",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bookmark"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/bookmarks/{id}": {
      "get": {
        "tags": [
          "BookmarksEndpoints"
        ],
        "summary": "Get a bookmark by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The bookmark ID",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The bookmark",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bookmark"
                }
              }
            }
          },
          "404": {
            "description": "Bookmark not found"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "delete": {
        "tags": [
          "BookmarksEndpoints"
        ],
        "summary": "Delete a bookmark by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The bookmark ID",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Bookmark deleted"
          },
          "404": {
            "description": "Bookmark not found"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "put": {
        "tags": [
          "BookmarksEndpoints"
        ],
        "summary": "Update a bookmark by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The bookmark ID",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "description": "The updated bookmark data",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Bookmark"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The updated bookmark",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bookmark"
                }
              }
            }
          },
          "404": {
            "description": "Bookmark not found"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/bookmarks/tags": {
      "get": {
        "tags": [
          "BookmarksEndpoints"
        ],
        "summary": "Get tags and their counts from user's bookmarks",
        "responses": {
          "200": {
            "description": "List of tags with counts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TagFacet"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/bookmarks/archived": {
      "get": {
        "tags": [
          "BookmarksEndpoints"
        ],
        "summary": "Get user's archived bookmarks with cursor-based pagination",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of bookmarks to return per page. Default: 20",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Optional cursor for pagination. Use the NextCursor from a previous response to get the next page of results. Encoded as a base64 string.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of archived bookmarks sorted by archive date descending",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetBookmarksResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/bookmarks/import/msedge": {
      "post": {
        "tags": [
          "BookmarksEndpoints"
        ],
        "summary": "Import bookmarks from Microsoft Edge bookmarks JSON file",
        "requestBody": {
          "description": "The Edge bookmarks parser service",
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "file"
                ],
                "type": "object",
                "properties": {
                  "file": {
                    "$ref": "#/components/schemas/IFormFile"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "List of imported bookmarks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Bookmark"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid file format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/bookmarks/{id}/archive": {
      "post": {
        "tags": [
