@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="min-h-screen bg-slate-50 dark:bg-slate-950">
    <header class="border-b border-slate-200/80 bg-white/80 backdrop-blur dark:border-slate-800/80 dark:bg-slate-900/80">
        <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-6 py-4">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-600 text-sm font-semibold text-white shadow-sm">
                    A
                </div>
                <div>
                    <p class="text-sm font-semibold text-slate-900 dark:text-slate-100">Auth</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Account access</p>
                </div>
            </div>
            <div class="flex items-center gap-4 text-sm">
                @* show logout when authenticated *@
                <AuthorizeView>
                    <Authorized>
                        <form action="Account/Logout" method="post">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="@Navigation.GetUriWithQueryParameters("Account/Login", new Dictionary<string, object?> { ["ReturnUrl"] = Navigation.Uri })" />
                            <button type="submit" class="text-sm font-semibold text-slate-600 transition hover:text-slate-900 dark:text-slate-300 dark:hover:text-white">
                                Logout
                            </button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        @* no logout shown *@
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </header>

    <main class="mx-auto w-full max-w-6xl px-6 py-4">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
