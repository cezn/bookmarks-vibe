@page "/Account/ResetPasswordConfirmation"
<PageTitle>Reset password confirmation</PageTitle>

<section class="mx-auto max-w-lg">
    <div class="auth-card">
        <div class="auth-card-body space-y-3">
            <h1>Reset password confirmation</h1>
            <div class="auth-alert">
                Your password has been reset. Please <a class="auth-link" href="Account/Login">log in</a>.
            </div>
        </div>
    </div>
</section>
