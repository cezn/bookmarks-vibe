@using Auth.Services
@using Microsoft.AspNetCore.Identity

<div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 p-6" role="dialog">
    <div class="auth-card w-full max-w-2xl">
        <div class="auth-card-header flex items-center justify-between">
            <div>
                <h5 class="text-base font-semibold text-slate-900">Manage roles for @User?.UserName</h5>
                <p class="text-xs text-slate-500">Adjust access levels for this user.</p>
            </div>
            <button type="button" class="rounded-lg p-2 text-slate-500 transition hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800" @onclick="OnClose" aria-label="Close">
                ✕
            </button>
        </div>
        <div class="auth-card-body space-y-4">
            @if (isSaving)
            {
                <div class="auth-alert">
                    <span class="inline-flex items-center gap-2">
                        <span class="h-4 w-4 animate-spin rounded-full border-2 border-slate-300 border-t-transparent"></span>
                        Saving changes...
                    </span>
                </div>
            }
            else if (errorMessage != null)
            {
                <div class="auth-alert auth-alert-danger" role="alert">
                    <div class="flex items-start justify-between gap-4">
                        <span>@errorMessage</span>
                        <button type="button" class="text-sm font-semibold text-red-700 dark:text-red-200" @onclick="() => errorMessage = null">Dismiss</button>
                    </div>
                </div>
            }

            @if (User != null && AllRoles != null)
            {
                <div class="space-y-2">
                    <label class="auth-label">Available roles</label>
                    <div class="max-h-72 space-y-2 overflow-y-auto rounded-xl border border-slate-200 bg-slate-50/60 p-3 dark:border-slate-700 dark:bg-slate-800/60">
                        @foreach (var role in AllRoles)
                        {
                            var isAssigned = User.Roles.Contains(role.Name ?? "");
                            <label class="flex items-center justify-between rounded-lg bg-white px-3 py-2 text-sm text-slate-700 shadow-sm">
                                <span class="flex items-center gap-2">
                                    <input class="h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500"
                                           type="checkbox"
                                           id="role_@role.Id"
                                           @bind="selectedRoles[role.Id]"
                                           disabled="@isSaving" />
                                    <span>@role.Name</span>
                                </span>
                                @if (isAssigned)
                                {
                                    <span class="auth-badge">Assigned</span>
                                }
                            </label>
                        }
                    </div>
                </div>

                <div class="auth-alert">
                    <strong>Current roles:</strong>
                    @if (User.Roles.Count == 0)
                    {
                        <p class="mt-2 text-sm text-slate-600">No roles assigned</p>
                    }
                    else
                    {
                        <div class="mt-2 flex flex-wrap gap-2">
                            @foreach (var role in User.Roles)
                            {
                                <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-700">@role</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
        <div class="flex items-center justify-end gap-2 border-t border-slate-100 px-6 py-4">
            <button type="button" class="auth-button-secondary" @onclick="OnClose" disabled="@isSaving">
                Cancel
            </button>
            <button type="button" class="auth-button" @onclick="SaveChanges" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="inline-flex items-center gap-2">
                        <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/60 border-t-transparent"></span>
                        Saving...
                    </span>
                }
                else
                {
                    <span>Save changes</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public UserRoleDto? User { get; set; }

    [Parameter]
    public List<RoleDto>? AllRoles { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnSave { get; set; }

    [Inject]
    private UserRoleService UserRoleService { get; set; } = default!;

    [Inject]
    private ILogger<UserRoleModal> Logger { get; set; } = default!;

    private Dictionary<string, bool> selectedRoles = new();
    private bool isSaving = false;
    private string? errorMessage;

    protected override Task OnParametersSetAsync()
    {
        if (User != null && AllRoles != null)
        {
            selectedRoles.Clear();
            foreach (var role in AllRoles)
            {
                selectedRoles[role.Id] = User.Roles.Contains(role.Name ?? "");
            }
        }
        return Task.CompletedTask;
    }

    private async Task SaveChanges()
    {
        if (User == null || AllRoles == null)
            return;

        isSaving = true;
        errorMessage = null;

        try
        {
            // Determine which roles to add and remove
            var rolesToRemove = AllRoles
                .Where(r => User.Roles.Contains(r.Name ?? "") && !selectedRoles.GetValueOrDefault(r.Id, false))
                .ToList();

            var rolesToAdd = AllRoles
                .Where(r => !User.Roles.Contains(r.Name ?? "") && selectedRoles.GetValueOrDefault(r.Id, false))
                .ToList();

            // Remove roles
            foreach (var role in rolesToRemove)
            {
                var result = await UserRoleService.RemoveRoleFromUserAsync(User.Id, role.Id);
                if (!result.Succeeded)
                {
                    errorMessage = $"Failed to remove role {role.Name}: {string.Join(", ", result.Errors.Select(e => e.Description))}";
                    isSaving = false;
                    return;
                }
            }

            // Add roles
            foreach (var role in rolesToAdd)
            {
                var result = await UserRoleService.AssignRoleToUserAsync(User.Id, role.Id);
                if (!result.Succeeded)
                {
                    errorMessage = $"Failed to assign role {role.Name}: {string.Join(", ", result.Errors.Select(e => e.Description))}";
                    isSaving = false;
                    return;
                }
            }

            // Success
            isSaving = false;
            await OnSave.InvokeAsync();
            await OnClose.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving role changes");
            errorMessage = $"An error occurred: {ex.Message}";
            isSaving = false;
        }
    }
}
