@page "/Account/Admin/Users"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Auth.Services
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@inject UserRoleService UserRoleService
@inject UserManager<ApplicationUser> UserManager
@inject ILogger<Users> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider
@rendermode InteractiveServer

<PageTitle>Manage Users</PageTitle>

<div class="space-y-6">
    <div class="space-y-2">
        <h1>User management</h1>
        <p class="text-sm text-slate-600">Review users and manage role assignments.</p>
    </div>

    @if (!isAuthorized)
    {
        <div class="auth-alert auth-alert-danger">
            You do not have permission to access this page. Only administrators can manage user roles.
        </div>
    }
    else if (users == null)
    {
        <p class="text-sm text-slate-500">Loading users...</p>
    }
    else
    {
        <div class="auth-alert">Total users: <strong>@users.Count</strong></div>

        @if (users.Count == 0)
        {
            <div class="auth-alert auth-alert-warning">No users found.</div>
        }
        else
        {
            <div class="overflow-x-auto rounded-2xl border border-slate-200">
                <table class="w-full text-sm">
                    <thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                        <tr>
                            <th class="px-4 py-3">Username</th>
                            <th class="px-4 py-3">Email</th>
                            <th class="px-4 py-3">Verified</th>
                            <th class="px-4 py-3">Roles</th>
                            <th class="px-4 py-3 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var user in users)
                        {
                            <tr class="bg-white">
                                <td class="px-4 py-3 font-semibold text-slate-900">@user.UserName</td>
                                <td class="px-4 py-3 text-slate-600">@user.Email</td>
                                <td class="px-4 py-3">
                                    @if (user.EmailConfirmed)
                                    {
                                        <span class="auth-badge">Verified</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700">Unverified</span>
                                    }
                                </td>
                                <td class="px-4 py-3">
                                    @if (user.Roles.Count == 0)
                                    {
                                        <span class="text-xs text-slate-500">No roles assigned</span>
                                    }
                                    else
                                    {
                                        <div class="flex flex-wrap gap-1">
                                            @foreach (var role in user.Roles)
                                            {
                                                <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-700">@role</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="px-4 py-3 text-right">
                                    <button class="auth-button-secondary" @onclick="() => OpenEditModal(user)">
                                        Manage roles
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@if (showModal && selectedUser != null)
{
    <UserRoleModal User="selectedUser"
                   AllRoles="allRoles!"
                   OnClose="CloseModal"
                   OnSave="HandleRoleSave" />
}

@code {
    private List<UserRoleDto>? users;
    private List<RoleDto>? allRoles;
    private UserRoleDto? selectedUser;
    private bool showModal = false;
    private bool isAuthorized = false;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // Check if user is admin
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            isAuthorized = user.IsInRole("admin");
        }

        if (isAuthorized)
        {
            users = await UserRoleService.GetAllUsersAsync();
            allRoles = await UserRoleService.GetAllRolesAsync();
        }
    }

    private void OpenEditModal(UserRoleDto user)
    {
        selectedUser = user;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        selectedUser = null;
    }

    private async Task HandleRoleSave()
    {
        CloseModal();
        users = await UserRoleService.GetAllUsersAsync();
    }
}
