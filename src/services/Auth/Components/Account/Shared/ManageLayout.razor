@inherits LayoutComponentBase
@layout Auth.Components.Layout.MainLayout

<section class="space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Account</p>
            <h1 class="text-2xl">Manage your account</h1>
            <p class="text-xs text-slate-500">Update your profile, security settings, and login preferences.</p>
        </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-[260px_1fr]">
        <aside class="auth-card h-fit">
            <div class="auth-card-header">
                <h2 class="text-base font-semibold text-slate-900">Settings</h2>
                <p class="text-xs text-slate-500">Jump between sections</p>
            </div>
            <div class="auth-card-body">
                <ManageNavMenu />
            </div>
        </aside>

        <section class="auth-card">
            <div class="auth-card-body space-y-4">
                @Body
            </div>
        </section>
    </div>
</section>
