{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "redis": "redis:6379",
    "authdb": "host=db;database=authdb;user id=postgres;password=secret;"
  },
  "AuthMessageSenderOptions": {
    "SmtpHost": "mailhog",
    "SmtpPort": 1025,
    "SmtpUsername": null,
    "SmtpPassword": null,
    "FromEmail": "noreply@bookmarks.local",
    "FromName": "Bookmarks",
    "EnableSsl": false
  },
  "ForwardedHeaders": {
    "ForwardedHeaders": "All",
    "KnownIPNetworks": ["172.18.0.0/16"]
  }
}
