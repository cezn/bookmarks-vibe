{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ConnectionStrings": {
    "redis": "localhost:6379",
    "authdb": "host=localhost;database=authdb;user id=postgres;password=secret;"
  },
  "AuthMessageSenderOptions": {
