{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Kafka.Consumer": "Information"
    }
  },
  "ConnectionStrings": {
    "kafka": "127.0.0.1:9092"
  },
  "SchemaRegistryUrl": "http://127.0.0.1:8081",
  "Kafka": {
    "BootstrapServers": "127.0.0.1:9092",
    "SchemaRegistryUrl": "http://127.0.0.1:8081",
    "Debug": "consumer,cgrp,topic,fetch"
  },
  "BookmarksApi": {
    "Url": "http://localhost:5002",
    "ApiKey": "bookmarks-service-key-dev-only",
    "Resilience": {
      "RateLimiter": {
        "DefaultRateLimiterOptions": {
          "PermitLimit": 1000,
          "QueueProcessingOrder": "OldestFirst",
          "QueueLimit": 0
        }
      },
      "TotalRequestTimeout": {
        "Timeout": "00:00:05"
      },
      "Retry": {
        "Delay": "00:00:01",
        "MaxDelay": null,
        "BackoffType": "Exponential",
        "UseJitter": true,
        "MaxRetryAttempts": 2,
        "ShouldRetryAfterHeader": true
      },
      "CircuitBreaker": {
        "MinimumThroughput": 100,
        "FailureRatio": 0.1,
        "BreakDuration": "00:00:05",
        "SamplingDuration": "00:00:30"
      },
      "AttemptTimeout": {
        "Timeout": "00:00:02"
      }
    }
  },
  "Aspire": {
    "Confluent": {
      "Kafka": {
        "Consumer": {
          "Config": {
            "Debug": "consumer,cgrp,topic,fetch"
          }
        }
      }
    }
  }
}