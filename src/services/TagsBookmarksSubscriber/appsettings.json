{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SchemaRegistryUrl": "http://schema-registry:8081",
  "Kafka": {
    "BootstrapServers": "broker1:9092",
    "SchemaRegistryUrl": "http://schema-registry:8081",
    "Dlq": {
      "Enabled": true,
      "Topic": "outbox.event.Bookmark.dlq",
      "BlockedUsersTopic": "bookmark.users.blocked",
      "ReplayHeaderName": "x-dlq-replay",
      "ReplayHeaderValue": "true",
      "BlockReason": "processing_failed"
    }
  },
  "BookmarksApi": {
    "Url": "http://bookmarksapi:8080",
    "ApiKey": "bookmarks-service-key-dev-only",
    "Resilience": {
      "RateLimiter": {
        "DefaultRateLimiterOptions": {
          "PermitLimit": 1000,
          "QueueProcessingOrder": "OldestFirst",
          "QueueLimit": 0
        }
      },
      "TotalRequestTimeout": {
        "Timeout": "00:00:20"
      },
      "Retry": {
        "Delay": "00:00:01",
        "MaxDelay": null,
        "BackoffType": "Exponential",
        "UseJitter": true,
        "MaxRetryAttempts": 2,
        "ShouldRetryAfterHeader": true
      },
      "CircuitBreaker": {
        "MinimumThroughput": 100,
        "FailureRatio": 0.1,
        "BreakDuration": "00:00:05",
        "SamplingDuration": "00:00:30"
      },
      "AttemptTimeout": {
        "Timeout": "00:00:02"
      }
    }
  },
  "Aspire": {
    "Confluent": {
      "Kafka": {
        "Consumer": {
          "DisableHealthChecks": true,
          "Config": {
            "GroupId": "bookmark-tags-extractor",
            "AutoOffsetReset": "Earliest",
            "EnableAutoCommit": true,
            "EnablePartitionEof": false,
            "EnableAutoOffsetStore": false,
            "MaxPollIntervalMs": 300000,
            "IsolationLevel": "ReadCommitted",
            "StatisticsIntervalMs": 5000
          },
          "dlq-producer": {
            "Config": {
              "EnableIdempotence": true,
              "Acks": "All",
              "CompressionType": "Zstd",
              "LingerMs": 10,
              "MessageTimeoutMs": 30000,
              "BatchSize": 131072
            }
          },
          "blocked-users-consumer":{
            "Config": {
              "GroupId": "blocked-users",
              "AutoOffsetReset": "Earliest",
              "EnableAutoCommit": true,
              "EnableAutoOffsetStore": true,
              "EnablePartitionEof": false
            }
          }
        }
      }
    }
  }
}