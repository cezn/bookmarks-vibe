{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "bookmarks-gateway",
    "Audience": "bookmarks-api",
    "Key": "930591a8-2c0d-5b91-ba76-60087bd989c91c167c5c-9192-5b98-aaa2-f27d9cc473c7",
    "Lifetime": "01:00:00"
  },
  "ReverseProxy": {
    "Routes": {
      "bookmarks-route": {
        "ClusterId": "bookmarks",
        "Transforms": [{ "JwtTransform": "" }],
        "Match": {
          "Path": "/api/bookmarks/{**catch-all}"
        }
      },
      "tags-route": {
        "ClusterId": "bookmarks",
        "Transforms": [{ "JwtTransform": "" }],
        "Match": {
          "Path": "/api/tags/{**catch-all}"
        }
      },
      "summarize-route": {
        "ClusterId": "summarize",
        "Transforms": [{ "JwtTransform": "" }],
        "Match": {
          "Path": "/api/summarize/{**catch-all}"
        }
      },
      "otel-route": {
        "ClusterId": "otel-collector",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/otel/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/v1/{**catch-all}"
          }
        ]
      },
      "static-assets-route": {
        "ClusterId": "static-assets",
        "Transforms": [
          { "HtmlTransform": "" }
        ],
        "Match": {  
          "Path": "{**catch-all}"
        }
      },
      "auth-route": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "notifications-route": {
        "ClusterId": "notifications",
        "Transforms": [{ "JwtTransform": "" }],
        "Match": {
          "Path": "/notifications/{**catch-all}"
        }
      },
      "push-notifications-route": {
        "ClusterId": "push-notifications",
        "Transforms": [{ "JwtTransform": "" }],
        "Match": {
          "Path": "/api/push-notifications/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "bookmarks": {
        "Destinations": {
          "destination1": {
            "Address": "http://bookmarksapi:8080/"
          }
        }
      },
      "summarize": {
        "Destinations": {
          "destination1": {
            "Address": "http://summarizeapi:8080/"
          }
        }
      },
      "otel-collector": {
        "Destinations": {
          "destination1": {
            "Address": "http://otel-collector:4318/"
          }
        }
      },
      "static-assets": {
        "Destinations": {
          "destination1": {
            "Address": "http://staticassets:8080/"
          }
        }
      },
      "auth": {
        "Destinations": {
          "destination1": {
            "Address": "http://auth:8080/"
          }
        }
      },
      "notifications": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8080/"
          }
        }
      },
      "push-notifications": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8080/"
          }
        }
      }
    }
  },
  "ConnectionStrings": {
    "redis": "redis:6379"
  },
  "RateLimiter": {
    "PermitLimit": 5000,
    "Window": "00:00:10",
    "QueueProcessingOrder": "OldestFirst",
    "QueueLimit": 0
  }
}
